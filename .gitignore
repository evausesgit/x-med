.env
# Variables locales du compose app (docker-compose.app.yml) — non commitées,
# le modèle commité est .env.app.example.
.env.app.local
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.DS_Store
data/
*.xml
*.xml.gz
*.log
# .claude/ reste local (worktrees, réglages) SAUF les skills, versionnés
# pour outiller les prochains agents.
.claude/*
!.claude/skills/
bench/pubmed_ab_*.json
# Sorties locales de la boucle autoresearch X-Med (les manifestes/fixtures stables
# restent versionnés ; les runs réels peuvent contenir des requêtes et abstracts).
experiments/autoresearch_xmed/artifacts/
experiments/autoresearch_xmed/results.tsv
experiments/autoresearch_xmed/results.jsonl
experiments/autoresearch_xmed/run.log
