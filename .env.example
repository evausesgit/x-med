# Base de données APP (backoffice : doctors, saved_searches, article_fr…)
DATABASE_URL=postgresql+psycopg://xmed:xmed@localhost:5432/xmed

# Base de données CORPUS (miroir PubMed : articles, article_search…).
# Non renseignée → repli sur DATABASE_URL (infra monolithique actuelle).
# CORPUS_DATABASE_URL=postgresql+psycopg://xmed:xmed@localhost:5432/xmed

# Corpus PubMed local (téléchargé par data/pubmed/download_corpus.sh)
DATA_DIR=/home/geekette/data/pubmed

# API
API_HOST=0.0.0.0
API_PORT=8000
# Origines autorisées pour le frontend (CORS)
CORS_ORIGINS=http://localhost:3000
