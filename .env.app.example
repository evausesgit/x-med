# Variables du compose app (docker-compose.app.yml).
#
# Localement : copier vers .env.app.local (non commité) et lancer
#   docker compose -f docker-compose.app.yml --env-file .env.app.local up
# Sous Coolify : ces variables vivent dans la ressource (les SERVICE_PASSWORD_*
# sont générées par la plateforme), avec des valeurs scopées preview pour
# XMED_DEPLOYMENT_MODE, CORPUS_DATABASE_URL et CODEX_AUTH_DIR.

# Mot de passe ADMIN de la base app (xmed_admin — init seulement :
# propriétaire, migrations, drop/recreate). Coolify : généré automatiquement.
SERVICE_PASSWORD_APPDBADMIN=change-me-admin

# Mot de passe du rôle applicatif xmed_app_runtime (l'identité de l'API :
# DML sur les 7 tables, aucun DDL). Créé/réaligné par l'init à chaque run.
SERVICE_PASSWORD_APPDBRUNTIME=change-me-runtime

# production = seed une fois, puis migrations seules à chaque déploiement.
# preview    = drop + re-seed à CHAQUE déploiement (données jetables).
XMED_DEPLOYMENT_MODE=production

# Répertoire hôte des dumps de seed (latest.json + backoffice_*.dump),
# produits par scripts/backup_backoffice.py. Monté :ro sur init seulement.
SEED_DIR=/home/geekette/backups/xmed

# URL de la base corpus, via le réseau externe xmed-corpus-access
# (alias corpus-db). Rôles lecture seule : scripts/create_corpus_roles.sql.
#   prod    → xmed_api_ro
#   preview → xmed_preview_ro (variable scopée Coolify)
CORPUS_DATABASE_URL=postgresql+psycopg://xmed_api_ro:change-me@corpus-db:5432/xmed

# Auth du CLI codex, montée sur /home/api/.codex.
# En preview : TOUJOURS un dossier vide (la recherche codex dégrade proprement).
CODEX_AUTH_DIR=/tmp/xmed-codex-empty

# Origines CORS de l'API (le front passe par le rewrite /api/* du serveur
# Next, même origine — utile surtout en dev).
CORS_ORIGINS=http://localhost:3000

# Pré-filtre sur la table étroite article_search (true en prod, backfill fait).
USE_NARROW_SEARCH=false

# Notifications Telegram (optionnel — vide = repli CLI hermes, absent en conteneur).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Allowlist de comptes Google du front (web/proxy.ts), emails séparés par des
# virgules. ⚠️ VIDE = TOUT compte Google est accepté après login — à
# renseigner impérativement partout où la stack est exposée (prod ET previews).
XMED_ALLOWED_EMAILS=dr.exemple@gmail.com,yoann.ditte@gmail.com
